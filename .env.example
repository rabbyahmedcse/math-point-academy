# ---------------------------------------------------------------------------
# Copy to .env.local for local development. On Vercel set these under
# Project -> Settings -> Environment Variables. Placeholders only - never commit real values.
# None of these are NEXT_PUBLIC_* secrets; only NEXT_PUBLIC_APP_URL is exposed to the browser (it is a public URL).
# ---------------------------------------------------------------------------

# --- Database (server only) ---
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=coaching

# --- Better Auth (server only) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public origin of the deployed site, e.g. https://your-app.vercel.app (no trailing slash). Must match the browser origin.
BETTER_AUTH_URL=http://localhost:3000
# Same public origin; used by the browser auth client. Leave unset to use the current origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- First admin (only read by `npm run seed:admin`; remove after seeding) ---
ADMIN_NAME=Owner
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-12345

# --- Misc ---
APP_TIMEZONE=Asia/Dhaka
